# --- CENÁRIO: chão inclinado a 25°, paredes no referencial global ---

DEF Scene Group {
  children [
    # CHÃO INCLINADO A 25° em torno do eixo X
    # 25° = 0.4363323130 radianos
    Transform {
      rotation 1 0 0 0.4363323130
      children [
        Floor {
          appearance Parquetry {
            type "light strip"
